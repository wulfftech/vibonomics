# Copy to `.env` and edit. Every value is optional: Vibonomics runs with no configuration and no
# provider keys, and the app reads this file through docker compose's env_file. Keys set here take
# precedence over keys saved in the UI and show as locked in Settings.

# Where the database, the encryption key and the HTTP cache live on the host.
VIBONOMICS_CONFIG=./config
VIBONOMICS_PORT=2289
VIBONOMICS_URL_BASE=

# Ownership of /config inside the container and the container's time zone.
PUID=1000
PGID=1000
UMASK=002
TZ=Etc/UTC

# Password gate on the UI. Leave empty to rely on your reverse proxy or your LAN.
VIBONOMICS_PASSWORD=

# Fixed encryption key for stored provider keys (any long random string). Without it, Vibonomics
# generates secret.key in the config directory on first run, next to the database. Use a value from
# your secret store if the config directory is backed up anywhere.
VIBONOMICS_SECRET_KEY=

# --- Sandbox isolation ---------------------------------------------------------------------------
# By default the sandbox has no network at all and the app reaches it through a Unix socket on a
# shared in-memory volume. If your Docker host cannot share a Unix socket between containers, use
# TCP on an internal network instead by adding the override (separate the files with ; on Windows):
# COMPOSE_FILE=docker-compose.yml:docker/compose.sandbox-tcp.yml
#
# With TCP, the app refuses every request that arrives from the sandbox's network. Leave it on unless
# something else on that network must reach the app. It has nothing to do in the socket layout.
VIBONOMICS_SANDBOX_GUARD=on

# Shared secret between the app and the sandbox sidecar. Set it with the TCP layout, or if anything
# else can reach the sandbox. Both services read the same value.
VIBONOMICS_SANDBOX_TOKEN=

VIBONOMICS_LOG_LEVEL=info

# --- Provider keys -----------------------------------------------------------------------------
# The variable name is VIBONOMICS_<TYPE>_API_KEY, where TYPE is the provider type in upper case with
# dashes as underscores. Uncomment the ones you use. `_MGMT_KEY` is the optional management or admin
# key (OpenRouter credits, xAI prepaid balance, OpenAI/Anthropic org spend). `_EXTRA_KEY` is the
# optional second secret; Anthropic uses it for a Claude Code login token.
#
# VIBONOMICS_OPENROUTER_API_KEY=
# VIBONOMICS_OPENROUTER_MGMT_KEY=
# VIBONOMICS_OPENCODE_API_KEY=
# VIBONOMICS_OPENCODE_GO_API_KEY=
# VIBONOMICS_ANTHROPIC_API_KEY=
# VIBONOMICS_ANTHROPIC_MGMT_KEY=
# VIBONOMICS_ANTHROPIC_EXTRA_KEY=
# VIBONOMICS_OPENAI_API_KEY=
# VIBONOMICS_OPENAI_MGMT_KEY=
# VIBONOMICS_GOOGLE_API_KEY=
# VIBONOMICS_DEEPSEEK_API_KEY=
# VIBONOMICS_XAI_API_KEY=
# VIBONOMICS_XAI_MGMT_KEY=
# VIBONOMICS_MISTRAL_API_KEY=
# VIBONOMICS_GROQ_API_KEY=
# VIBONOMICS_MOONSHOT_API_KEY=
# VIBONOMICS_ZAI_API_KEY=
# VIBONOMICS_TOGETHER_API_KEY=
# VIBONOMICS_FIREWORKS_API_KEY=
# VIBONOMICS_CEREBRAS_API_KEY=
# VIBONOMICS_REQUESTY_API_KEY=
# VIBONOMICS_REQUESTY_MGMT_KEY=
# VIBONOMICS_CHUTES_API_KEY=
# VIBONOMICS_NVIDIA_API_KEY=
